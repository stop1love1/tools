# Port HTTP + WebSocket của server Go
PORT=8080

# MongoDB (bỏ trống vẫn chạy được, chỉ mất tính năng lưu trữ)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=tiktok_live

# API key Euler Stream (tùy chọn — cần khi dùng nhiều, đăng ký tại eulerstream.com)
SIGN_API_KEY=

# Địa chỉ sidecar Python (API dữ liệu video/user/comment/trending)
SIDECAR_URL=http://127.0.0.1:8500
