{
  "name": "jira-dashboard",
  "private": true,
  "version": "1.0.0",
  "description": "Local dashboard for my Jira issues and their Confluence docs",
  "homepage": "https://github.com/stop1love1/tools",
  "author": "stop1love1",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "start:electron": "electron . --no-sandbox --ozone-platform-hint=auto --enable-features=WaylandWindowDecorations",
    "test": "node --test",
    "build": "pkg . --compress Brotli",
    "build:linux": "pkg . --targets node18-linux-x64 --compress Brotli -o dist/jira-dashboard-linux",
    "build:electron": "electron-builder --linux AppImage deb",
    "package": "bash build-package.sh",
    "clean": "rm -rf dist/"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "lib/**/*.js"
    ],
    "scripts": [
      "lib/**/*.js"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "livereload": "0.10.3",
    "pkg": "^5.8.1"
  },
  "main": "electron-main.js",
  "build": {
    "appId": "com.jira.dashboard",
    "productName": "Jira Dashboard",
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.js",
    "files": [
      "package.json",
      "electron-main.js",
      "preload.js",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "jira-dashboard",
      "icon": "assets/icon.png",
      "desktop": {
        "StartupWMClass": "jira-dashboard"
      }
    },
    "deb": {
      "maintainer": "pn.longdc"
    }
  },
  "desktopName": "jira-dashboard.desktop"
}
