# Tuỳ chọn — mọi giá trị đều có mặc định. Copy thành .env nếu cần đổi.
# Không cần API token: tool dùng token OAuth mà Claude Code đã lưu khi kết nối Atlassian MCP.

# JIRA_SITE_URL=https://vin3s.atlassian.net
# PORT=4747
# MCP_SERVER_NAME=atlassian
# Mặc định: $HOME/.claude/.credentials.json (đường dẫn tuyệt đối, không dùng ~)
# CLAUDE_CREDENTIALS_FILE=/home/you/.claude/.credentials.json
# DEFAULT_JQL=assignee = currentUser() AND (statusCategory != Done OR updated >= -14d) ORDER BY updated DESC

# Lệnh mở editor cho nút "Claude Code" (mặc định: cursor trong PATH) và scheme URL của nó
# EDITOR_BIN=/home/you/Downloads/squashfs-root/usr/bin/cursor
# EDITOR_URI_SCHEME=cursor

# Git flow: thư mục chứa backend/ và frontend/, và nơi đặt worktree tạm của dashboard
# LMS_ROOT=/home/you/Documents/lms
# GIT_SCRATCH_ROOT=/home/you/Documents/lms-worktrees
